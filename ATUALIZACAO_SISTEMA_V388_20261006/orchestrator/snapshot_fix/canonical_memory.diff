+def _snapshot_json(raw):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ValueError('Campo duplicado no snapshot TGL.')
+            result[key] = value
+        return result
+    return json.loads(raw, object_pairs_hook=pairs)
