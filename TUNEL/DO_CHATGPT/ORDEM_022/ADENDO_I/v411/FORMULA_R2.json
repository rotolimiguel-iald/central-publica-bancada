  "translations": {
    "beta": {
      "pt-BR": "A constante da estrutura fina, no valor de referência CODATA 2018, multiplica o radical entrópico — a raiz quadrada do número de Euler —, dando a taxa de acoplamento beta TGL.",
      "en": "The fine-structure constant, at its CODATA 2018 reference value, multiplies the entropic factor—the square root of Euler’s number—giving the TGL coupling rate, beta TGL.",
      "fr": "La constante de structure fine, à sa valeur de référence CODATA 2018, multiplie le facteur entropique — la racine carrée du nombre d’Euler — et donne le taux de couplage TGL, bêta TGL.",
      "zh-Hans": "精细结构常数取 CODATA 2018 参考值，乘以熵因子——欧拉数的平方根——得到 TGL 耦合率，即 beta TGL。"
    },
    "radical": {
      "pt-BR": "A raiz quadrada da taxa de acoplamento beta TGL dá o módulo da amplitude refletida. Essa radicalização liga peso e amplitude. O quadrado recupera o peso.",
      "en": "The square root of the TGL coupling rate, beta TGL, gives the magnitude of the reflected amplitude. This radicalization connects weight and amplitude. Squaring recovers the weight.",
      "fr": "La racine carrée du taux de couplage TGL, bêta TGL, donne le module de l’amplitude réfléchie. Cette radicalisation relie poids et amplitude. Le carré restitue le poids.",
      "zh-Hans": "TGL 耦合率，即 beta TGL，其平方根给出反射振幅的模。取根把权重与振幅联系起来，平方即可还原权重。"
    }
  },
