F1Citations.AppliedBridge.appliedFullWitness : TGL.ModularRealization.FullTGLWitness
F1Citations.AppliedBridge.applied_qg_solution_end_to_end (N : TGLExt.ContratoQGv31.KillingNormalization) (G : ℝ)
  (hG : 0 < G) {x₀ : Fin 4 → ℝ} (hx₀ : x₀ ∈ TGL.SpecificAQFT.rightWedge) {ψ : physicalFockCertificate.F}
  (hψ : ψ ∈ (TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).admissible)
  (x : Fin 4 → ℝ) (c d : ℝ)
  (hθ :
    (TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).theta ψ
        (x + d • TGLExt.ContratoQGv31.nullDir) =
      0) :
  (0 < (TGLV354.coreProjectionTraceSubadditive TGLExt.mixProfile).tau (TGLV354.regularSusyData TGLExt.mixProfile).ker ∧
      (TGLV354.coreProjectionTraceSubadditive TGLExt.mixProfile).tau (TGLV354.regularSusyData TGLExt.mixProfile).ker <
        ⊤) ∧
    (TGLV354.coreProjectionTraceSubadditive TGLExt.mixProfile).tau (TGLV354.regularSusyData TGLExt.mixProfile).ker /
          (TGLV354.coreProjectionTraceSubadditive TGLExt.mixProfile).tau
            (TGLV354.regularSusyData TGLExt.mixProfile).ker =
        1 ∧
      (((TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).H2.E x₀)⁻¹ *
              (TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).H2.E x₀ =
            1 ∧
          TGLExt.LorentzByCongruence
            (TGLExt.solderMetric4
              ((TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).H2.E x₀)⁻¹)) ∧
        ((TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).toHorizonData hψ x c d
              hθ).dQ =
          ((TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).toHorizonData hψ x c
                  d hθ).kappa *
              ((TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).toHorizonData hψ
                  x c d hθ).dA /
            (8 * Real.pi *
              ((TGLExt.ImportedSQ.lightH3 (F1Fecho.MaxwellGlobal.physicalMaxwellCertificate N) N G hG).toHorizonData hψ
                  x c d hθ).G)
