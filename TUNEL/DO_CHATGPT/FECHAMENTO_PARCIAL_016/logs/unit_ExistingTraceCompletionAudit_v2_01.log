TGLV354.TraceCompletion.cyclicTraceCandidate_cyclic (P : TGLExt.SiteProfile)
  (x y : ↥(TGLV350.Regular.regularCoreAlgebra P).toStarSubalgebra) :
  TGLV354.TraceCompletion.cyclicTraceCandidate P (x * y) = TGLV354.TraceCompletion.cyclicTraceCandidate P (y * x)
TGLV354.TraceCompletion.cyclicTraceCandidate_positive (P : TGLExt.SiteProfile)
  (p : TGLV350.Regular.PositiveCoreInput P) :
  TGLV354.TraceCompletion.cyclicTraceCandidate P ⟨↑p, ⋯⟩ = TGLV350.Regular.scalarInverseLimitWeight P p
TGLV354.TraceCompletion.regularLegacyCore :
  TGL.ModularRealization.ContinuousCoreData TGLExt.theSpecificAQFTWitness TGLExt.V350Continuous.towerWedgeData
'TGLV354.TraceCompletion.cyclicTraceCandidate_cyclic' depends on axioms: [propext, Classical.choice, Quot.sound]
'TGLV354.TraceCompletion.cyclicTraceCandidate_positive' depends on axioms: [propext, Classical.choice, Quot.sound]
'TGLV354.TraceCompletion.regularLegacyCore' depends on axioms: [propext, Classical.choice, Quot.sound]
