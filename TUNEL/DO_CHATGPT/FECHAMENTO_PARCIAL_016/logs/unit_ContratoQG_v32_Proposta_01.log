fun W0 R0 N0 B T0 h2 c =>
  D6.same_horizon_by_content_from_realizations c.same_horizon R0.modular.modularConjugation
    R0.modular.modularConjugation h2.Δit c.produce.light_horizon.Δit c.source_realization
    c.produce.light_horizon.pair_realization : ∀ (W0 : TGLSpecificAQFTWitness) (R0 : TGLModularRealization W0)
  (N0 : KillingNormalization) (B : WedgeBoostRep W0) (T0 : StressTensorDataLocal_v2 W0 B) (h2 : ContratoH2 W0 R0 N0)
  (c : ContratoImportH3 W0 R0 N0 B T0 h2),
  (∀ (x : W0.H),
      c.same_horizon.U (R0.modular.modularConjugation (c.same_horizon.U.symm x)) = R0.modular.modularConjugation x) ∧
    ∀ (t : ℝ) (x : W0.H), c.same_horizon.U ((h2.Δit t) (c.same_horizon.U.symm x)) = (c.produce.light_horizon.Δit t) x
