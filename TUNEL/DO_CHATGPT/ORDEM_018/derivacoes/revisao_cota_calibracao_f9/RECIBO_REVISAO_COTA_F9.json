  "mathematical_review": [
    {
      "claim": "whitened supported nuisance quotient",
      "assessment": "RX=0 and RCR^T=I on nu=r-63 follow from supported rank63 X and orthonormal complement; q_true is exact chi-square, independent of eta."
    },
    {
      "claim": "uniform residual envelope",
      "assessment": "G1<=q1,true; Q1<=G1; Tj1<=Gj under each null; no further subtraction of physical parameter dimension."
    },
    {
      "claim": "global difference-span envelope",
      "assessment": "All competing mean differences in fixed V imply g_comp>=||(I-PiV)Z||^2; subtract from g_null<=||Z||^2 to obtain gain<=||PiV Z||^2. Nonlinearity harmless when full global inclusion holds."
    },
    {
      "claim": "17/18 directions",
      "assessment": "Structural upper bounds from16 compressed background coordinates plus a_h, adding c_C for H4; not measured ranks/Wilks df or proof of implemented mean map."
    },
    {
      "claim": "conditional148 and inherited nulls",
      "assessment": "Exact72 local covariance null directions extend to any joint PSD C; supported rank63 X then permits stated upper dimension. Extra cross-covariance can violate PSD/support unless qualified; subset143 cannot replace full267."
    },
    {
      "claim": "minimum and tail certificates",
      "assessment": "ellG=max(0,L1), ellQ=max(0,L1-U3) under nesting, ellT=Lj-U1 are lower statistics; decreasing survival yields conservative upper p. Local feasible minima only give U. SF evaluation also needs certified upper error."
    },
    {
      "claim": "different-covariance counterexample",
      "assessment": "Log determinant term invalidates RSS identity; given epsilon asymptotic defeats even a universal chi-square1 tail envelope, not only a pointwise inequality."
    },
    {
      "claim": "inflated covariance extension",
      "assessment": "Under fixed Gaussian Sigma<=a C on common support, projected eigenvalues<=a imply a chi-square domination; no adaptive or estimated-covariance extension inferred."
    },
    {
      "claim": "V2 and multiplicity",
      "assessment": "Complete-scenario max then Bonferroni5 preserves validity. Weak but valid p upper is non-rejection of conservative test, not missing calibration or proof that exact p exceeds alpha."
    }
  ],
  "alternatives": [
    {
      "id": "A",
      "description": "General residual envelope with qualified nu or deterministic upper bound; more conservative, fewer mean-span prerequisites."
    },
    {
      "id": "B",
      "description": "Residual G plus17/18 structural gain envelopes after full mean-map inclusion certification; tighter candidate, no power guarantee."
    },
    {
      "id": "C",
      "description": "Sharper calibration only in separately authorized future work if conservatism prevents useful inference."
    }
  ],
  "failure_modes": [
    {
      "id": "F01",
      "description": "Single-point tangent rank cannot stand for global mean-difference span; curved means may leave tangent."
    },
    {
      "id": "F02",
      "description": "Feasible local optimizer output is upper bound on minimum; using it as L can manufacture rejection."
    },
    {
