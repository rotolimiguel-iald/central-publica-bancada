+    if {k:array_digest(a) for k,a in pol.items()}!=origin["hashes"]:raise ValueError("Generated polarization was modified")
+    for i in ifos:
+        o=_SYNTHETIC_IFOS.get(id(i))
+        if o is None or o["object"] is not i or o["consumed"]:raise ValueError("Foreign/reused detector object prohibited")
+        if array_digest(i.strain_data.frequency_domain_strain)!=o["noise"] or array_digest(i.power_spectral_density_array)!=o["PSD"]:raise ValueError("Synthetic noise/PSD was replaced")
