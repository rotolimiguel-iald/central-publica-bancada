      },
      "relevant_lines": [
        {
          "line": 8,
          "text": "LINUX = Path(\"/mnt/c/IALD/Central de Patentes/Chatgpt/TUNEL/DO_CHATGPT/ORDEM_018/preregistros/conjunto_d/guard_wsl_integration_preparation_v2\")"
        },
        {
          "line": 9,
          "text": "BASE = WIN if os.name == \"nt\" else LINUX"
        },
        {
          "line": 10,
          "text": "PY = \"/opt/lal_env/bin/python\""
        },
        {
          "line": 51,
          "text": "            \"exe\":str((p/\"exe\").resolve(strict=True)),\"argv\":(p/\"cmdline\").read_bytes().split(b\"\\0\")[:-1],"
        },
        {
          "line": 53,
          "text": "def serial_identity(x): return {**x,\"argv\":[s.decode() for s in x[\"argv\"]]}"
        },
        {
          "line": 54,
          "text": "def matches(x, argv):"
        },
        {
          "line": 55,
          "text": "    return x[\"exe\"]==\"/usr/bin/python3.12\" and x[\"argv\"]==[s.encode() for s in argv]"
        },
        {
          "line": 56,
          "text": "def exact_signal(pid, argv):"
        },
        {
          "line": 60,
          "text": "        x=proc_identity(pid); need(matches(x,argv), \"Process identity changed; no signal\")"
        },
        {
          "line": 64,
          "text": "def argv_for(role, nonce):"
        },
        {
          "line": 66,
          "text": "    return [PY,*FLAGS,str(LINUX/script),role,REQUEST,nonce]"
        },
        {
          "line": 68,
          "text": "    targets=[argv_for(\"--supervisor\",nonce),argv_for(\"--child\",nonce)]; found=[]"
        }
      ],
      "literal_root_flag_occurrences": 0
    },
    {
      "source": {
        "path": "C:\\IALD\\Central de Patentes\\Chatgpt\\TUNEL\\DO_CHATGPT\\ORDEM_018\\preregistros\\conjunto_d\\guard_wsl_integration_preparation_v2\\launch_windows.py",
        "bytes": 8994,
        "sha256": "49b65462f64125ee5afce32bfac4a73d82daabefe25e359fab897a0af4deac32",
        "mtime_utc": "2026-10-06T06:31:07.003714+00:00"
      },
      "relevant_lines": [
        {
          "line": 6,
          "text": "BASE=Path(r\"C:\\IALD\\Central de Patentes\\Chatgpt\\TUNEL\\DO_CHATGPT\\ORDEM_018\\preregistros\\conjunto_d\\guard_wsl_integration_preparation_v2\")"
        },
        {
          "line": 7,
          "text": "WSL=r\"C:\\Windows\\System32\\wsl.exe\""
        },
        {
          "line": 50,
          "text": "    argv=[WSL,\"--distribution\",\"Ubuntu-24.04\",\"--exec\",*g.argv_for(mode,nonce)]"
        },
        {
          "line": 51,
          "text": "    proc=subprocess.Popen(argv,cwd=BASE,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,"
        },
        {
          "line": 53,
          "text": "    return proc,Capture(proc),argv"
        },
        {
          "line": 67,
          "text": "    g,c=load();g.need(os.name==\"nt\" and sys.argv[1:]==[\"--run-once\"],\"Fixed Windows entry\")"
        },
        {
          "line": 80,
          "text": "        primary,pcap,pargv=launch(g,\"--supervisor\",nonce)"
        },
        {
          "line": 81,
          "text": "        g.fresh(run/\"WSL_PROCESS.json\",{\"request_id\":g.REQUEST,\"nonce\":nonce,\"pid\":primary.pid,\"argv\":pargv,\"handle_owned_by_this_launcher\":True})"
        },
        {
          "line": 84,
          "text": "        linux=json.loads(pcap.text(\"stdout\"));g.need(linux==g.read(run/\"LINUX_RESULT.json\"),\"Linux result stream mismatch\")"
        },
        {
          "line": 95,
          "text": "            cleaner,ccap,cargv=launch(g,\"--cleanup\",nonce)"
        },
        {
          "line": 96,
          "text": "            g.fresh(run/\"CLEANUP_WSL_PROCESS.json\",{\"request_id\":g.REQUEST,\"nonce\":nonce,\"pid\":cleaner.pid,\"argv\":cargv})"
        }
      ],
      "literal_root_flag_occurrences": 0
    },
    {
      "source": {
        "path": "C:\\IALD\\Central de Patentes\\Chatgpt\\TUNEL\\DO_CHATGPT\\ORDEM_018\\preregistros\\conjunto_d\\guard_wsl_integration_preparation_v2\\linux_control.py",
        "bytes": 9734,
        "sha256": "b1be6a937997cd6983a4280d6da12380bd8e30515e982bee919f6569fccd673c",
        "mtime_utc": "2026-10-06T06:31:06.987696+00:00"
      },
      "relevant_lines": [
        {
          "line": 6,
          "text": "BASE=Path(\"/mnt/c/IALD/Central de Patentes/Chatgpt/TUNEL/DO_CHATGPT/ORDEM_018/preregistros/conjunto_d/guard_wsl_integration_preparation_v2\")"
        },
        {
          "line": 22,
          "text": "def stop_child(g,proc,argv,deadline):"
        },
        {
          "line": 24,
          "text": "        try:g.exact_signal(proc.pid,argv)"
        },
        {
          "line": 29,
          "text": "def capture(g,proc,argv,deadline):"
        },
        {
          "line": 64,
          "text": "    g.fresh(BASE/\"RUN/LINUX_CLAIM.json\",{\"request_id\":g.REQUEST,\"nonce\":nonce,\"process\":me,"
        },
        {
          "line": 66,
          "text": "    proc=None;argv=g.argv_for(\"--child\",nonce);status=\"FAILED\";error=None;streams=None;child=None;clean=False"
        },
        {
          "line": 72,
          "text": "            proc=subprocess.Popen(argv,cwd=BASE,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,"
        },
        {
          "line": 75,
          "text": "            g.need(g.matches(g.proc_identity(proc.pid),argv),\"Child identity after Popen\")"
        },
        {
          "line": 76,
          "text": "            g.fresh(BASE/\"RUN/CHILD_PROCESS.json\",{\"request_id\":g.REQUEST,\"nonce\":nonce,\"process\":childid,\"argv\":argv})"
        },
        {
          "line": 78,
          "text": "        streams=capture(g,proc,argv,work)"
        },
        {
          "line": 86,
          "text": "                if proc.poll() is None:stop_child(g,proc,argv,deadline);status=\"FAILED\""
        },
        {
          "line": 95,
          "text": "    g.fresh(BASE/\"RUN/LINUX_RESULT.json\",receipt)"
        },
        {
          "line": 109,
          "text": "        for x,argv in g.scoped_processes(nonce):"
        },
        {
          "line": 111,
          "text": "            try:stopped.append(g.exact_signal(x[\"pid\"],argv))"
        },
        {
          "line": 119,
          "text": "            for x,argv in live:"
        },
        {
          "line": 120,
          "text": "                try:stopped.append(g.exact_signal(x[\"pid\"],argv))"
        },
        {
          "line": 135,
          "text": "    g,c=load();g.need(len(sys.argv)==4 and sys.argv[1] in (\"--supervisor\",\"--cleanup\") and sys.argv[2]==g.REQUEST,\"Exact mode/identity\")"
        },
        {
          "line": 136,
          "text": "    nonce=sys.argv[3];g.check_pins(c,linux=True);_,ah=g.authorization(c);w=g.read(BASE/\"CLAIM.json\")"
        },
        {
          "line": 141,
          "text": "    if sys.argv[1]==\"--supervisor\":return supervise(g,c,w,nonce)"
        }
      ],
