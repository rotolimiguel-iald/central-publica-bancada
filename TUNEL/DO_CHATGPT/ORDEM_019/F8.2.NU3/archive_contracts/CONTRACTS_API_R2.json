  "channels": [
    {
      "id": "boundary_parity_4state",
      "scope": "current terminal article; finite boundary model",
      "status": "REAL documented finite operator; DERIVED analytic channel; physical time calibration INPUT",
      "hilbert_space": "C2_parity tensor C2_charge",
      "operator": "L_nu = X_A tensor I_B",
      "generator": "d rho / d s = L_nu rho L_nu - rho",
      "units": {
        "s": "dimensionless semigroup time",
        "rho": "trace-one density matrix",
        "L_nu": "dimensionless"
      },
      "parameters": {
        "beta0": "not itself a time rate",
        "s": "finite nonnegative input; s=rate_s_inv*t_s only with named rate"
      },
      "analytic_solution": "rho(s)=0.5*(1+exp(-2s))*rho0+0.5*(1-exp(-2s))*L_nu*rho0*L_nu",
      "observable": "for initial pure positive parity: p_minus(s)= -0.5*expm1(-2s)",
      "limits": [
        "parity transfer is not an absolute neutrino production count",
        "charge commutator and parity anticommutator do not determine flavor PMNS, physical emission rate, or uniqueness as Standard Model neutrino",
        "energy conservation requires [H,L_nu]=0; otherwise record environment energy exchange",
        "If beta(chi) is exposed in a future boundary probability API, enforce its coupling domain beta<1; mathematical beta(0)=sqrt(e) is not a valid probability"
      ],
      "api": "boundary_parity_evolution(rho0, modular_time) -> rho, parity_probabilities, trace_residual, charge_residual",
      "sources": [
        {
          "source_id": "S12",
          "first_line": 2821,
          "last_line": 2821
        },
        {
          "source_id": "S12",
          "first_line": 1014,
          "last_line": 1016
        }
      ]
    },
    {
      "id": "modular_root_dephasing",
      "scope": "current Ponte finite shadow",
      "status": "REAL formula in source; no new Lean compilation",
      "hilbert_space": "finite modular spectral realization",
      "operator": "L_mod = sqrt(beta0) sqrt(K_partial), K_partial positive in this realization",
      "generator": "D[L_mod](rho)=L_mod rho L_mod - 0.5{L_mod^2,rho}",
      "rates": "Gamma_ij_mod=0.5*beta0*(sqrt(k_i)-sqrt(k_j))^2",
      "units": {
        "k_i": "modular spectral input",
        "Gamma_mod": "inverse modular time under source convention"
      },
      "parameters": {
        "k_i": "nonnegative; not spacetime Kretschmann K",
        "beta0": "alpha_Thomson*sqrt(e)"
      },
      "limits": [
        "no silent identification of k_i with neutrino energy",
        "not same Hilbert space as parity-charge model or mass qutrit"
      ],
      "api": "modular_root_rates(k_nonnegative, alpha_thomson) -> symmetric_rate_matrix",
      "sources": [
        {
          "source_id": "S07",
          "first_line": 1104,
          "last_line": 1115
        },
        {
          "source_id": "S07",
          "first_line": 1235,
          "last_line": 1240
        }
      ]
    },
    {
      "id": "physical_mass_gap_dephasing",
      "scope": "mature June law and current terminal article, vacuum neutrinos",
      "status": "DERIVED conditional propagator from stated spectral law; tau_star and curvature mapping named INPUT",
      "hilbert_space": "C3_mass, with flavor readout through PMNS",
      "operator": "L_phys = sqrt(beta0*tau_star_s*Kfac)*H_eV/hbar_eV_s",
      "generator": "d rho/dt = -i[H,rho]/hbar - beta0*tau_star_s*Kfac*[H,[H,rho]]/(2*hbar^2)",
      "hamiltonian": "H_eV = diag(m_i^2)/(2*E_eV), identity shift irrelevant; vacuum ultrarelativistic approximation",
      "rates": "Gamma_ij_s_inv = 0.5*beta0*tau_star_s*Kfac*(delta_m2_ij_eV2/(2*E_eV*hbar_eV_s))^2; Gamma_ij_eV=hbar_eV_s*Gamma_ij_s_inv",
      "units": {
        "E_eV": "eV",
        "delta_m2_ij_eV2": "eV^2",
        "hbar_eV_s": "eV*s",
        "tau_star_s": "s",
        "Gamma_ij_s_inv": "s^-1",
        "Kfac": "dimensionless"
      },
      "parameters": {
        "alpha_thomson": "ALPHA_FINE_CODATA_2018 runtime input for this numeric instance",
        "beta0": "alpha_thomson*sqrt(e), fixed across energy",
        "tau_star_s": "finite nonnegative named input; t_P is canonical conditional instance, not forced derivation",
        "Kfac": "(K_Kretschmann/K_star)^beta0 when that physical profile is supplied; otherwise explicit independent dimensionless input",
        "PMNS": "unitary matrix input, not derived from beta"
      },
      "analytic_solution": "rho_ij(t)=rho_ij(0)*exp(-i*delta_H_ij*t/hbar)*exp(-Gamma_ij*t)",
      "texture": "Gamma21:Gamma31:Gamma32=(dm21^2)^2:(dm31^2)^2:(dm31^2-dm21^2)^2; not independent rates",
      "slope": "n=-2 for fixed tau_star and Kfac; otherwise -2+dln(tau_star)/dlnE+dln(Kfac)/dlnE",
      "limits": [
        "mass-diagonal rho is exactly unchanged by this channel",
        "preserves trace, complete positivity, and expectation of fixed H; not a source term for a star",
        "not a forward JUNO prediction without flux, matter, response, baseline and nuisance model",
        "no substitution beta(E) for beta0 in this channel; existing fixed-beta pre-registration",
        "tau_star_bound_neutrino_s=7.8e-10 is not an admitted bound; no transfer of experimental gamma limit without texture and likelihood matching"
      ],
      "api": "mass_dephasing_rates(E_eV, dm2_eV2, tau_star_s, Kfac, alpha_thomson) -> Gamma_s_inv; propagate_mass_density(rho0,H_eV,Gamma_s_inv,t_s)",
