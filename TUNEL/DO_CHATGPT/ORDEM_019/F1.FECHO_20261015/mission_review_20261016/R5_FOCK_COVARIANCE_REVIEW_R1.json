  "accepted_scope": [
    {
      "statute": "[REAL — fonte e compilação conferidas]",
      "claim": "spacetimeNet é FieldWeyl.R(compactLocalized O); spacetimeNet_coordinate identifica por rfl esta mesma rede com PhysicalFockNet.net no adaptador de coordenadas. Não foi criada uma segunda rede física."
    },
    {
      "statute": "[REAL — fonte e compilação conferidas]",
      "claim": "Covariância sob translação e generatedLorentz é fornecida por compactLocalized_translate_iff e compactLocalized_lorentz_iff. Ambos são teoremas derivados de transformações dos testes, seus suportes, fechamento e inversas. Não permanecem como uma hipótese h do chamador."
    },
    {
      "statute": "[REAL — fonte e compilação conferidas]",
      "claim": "FieldWeyl.R_covariance transporta essa igualdade de subespaços reais para a conjugação pela segunda quantização gamma da mesma isometria H1. FieldWeyl.W_covariance usa o campo W(f)=D(i*f), preservando sua convenção."
    },
    {
      "statute": "[REAL — fonte e compilação conferidas]",
      "claim": "frameUnitary L a é helicityPoincareH1 a L por rfl, com ordem U1(a) após helicityUnitary(L); frameRegion tem a mesma ordem de Lorentz e translação. O consumidor para FutureLorentz usa helicityUnitary(futureToGenerated L), não a representação escalar do módulo adaptador."
    },
    {
      "statute": "[REAL — fonte e compilação conferidas]",
      "claim": "physicalNet_translate e physicalNet_boost descarregam a antiga premissa genérica net_covariant pelos teoremas compactPhysicalNet_translate/boost. Os enunciados são equivalências de pertença de operadores arbitrários A nas álgebras."
    }
  ],
