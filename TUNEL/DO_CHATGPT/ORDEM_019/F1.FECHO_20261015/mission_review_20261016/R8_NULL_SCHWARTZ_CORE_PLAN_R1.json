    "screenAmplitudeOf": "def screenAmplitudeOf (g : MomentumCoordinates → Fib) (a : Fin 2) (y : MomentumCoordinates) : ℂ := ∑ j : Fin 2, (nullPolarization y a j : ℂ) * g y j",
    "nullCoreAmplitude": "def nullCoreAmplitude (g : MomentumCoordinates → Fib) (a : Fin 2) (p : NullFourierSpace) : ℂ := if 0 < p 0 then screenAmplitudeOf g a (nullMomentumCoordinates (fun j : Fin 2 => p j.succ) (p 0)) else 0",
    "inverse_without_sqrt": "inverseLongitudinal (transverseMass 0 q) u = (q 0 ^ 2 + q 1 ^ 2 - u ^ 2) / (2 * u), by transverseMass_sq; use this for smoothness on u>0",
    "no_charge_assumption": true
  },
