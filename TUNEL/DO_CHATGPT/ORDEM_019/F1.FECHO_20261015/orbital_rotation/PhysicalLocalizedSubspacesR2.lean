import PhysicalSmearTranslationR2

/-! The actual closed real subspaces generated by supported real Maxwell tests.
This block proves isotony, translation covariance and global nontriviality.
Causal locality and equality of its right wedge with canonical KWR are NOT
fields here and are not asserted by these elementary support statements. -/
set_option autoImplicit false
set_option maxHeartbeats 1800000
noncomputable section
namespace F1Fecho.MaxwellLocalization
open F1Fecho.MaxwellGlobal TGLExt.ImportedSQ

def supportedGenerators (O : Set Spacetime) : Set H1 :=
  {v | ∃ f : SchwartzTensor, IsRealTest f ∧
    Function.support (f : Spacetime → TensorValue) ⊆ O ∧ circularSmear f=v}

def localized (O : Set Spacetime) : Submodule ℝ H1 :=
  (Submodule.span ℝ (supportedGenerators O)).topologicalClosure

theorem localized_closed (O : Set Spacetime) : IsClosed (localized O : Set H1) :=
  Submodule.isClosed_topologicalClosure _

theorem localized_mono {O P : Set Spacetime} (h : O ⊆ P) : localized O ≤ localized P := by
  apply Submodule.topologicalClosure_mono
  apply Submodule.span_mono
  rintro v ⟨f,hr,hs,hv⟩
  exact ⟨f,hr,hs.trans h,hv⟩

def translateRegion (a : Spacetime) (O : Set Spacetime) : Set Spacetime :=
  {x | x-a ∈ O}

theorem translated_generator (a : Spacetime) (O : Set Spacetime) (v : H1)
    (hv : v ∈ supportedGenerators O) :
    U1 (fun i => a i) v ∈ supportedGenerators (translateRegion a O) := by
  obtain ⟨f,hr,hs,rfl⟩:=hv
  refine ⟨translateTest a f,translateTest_real a f hr,?_,circularSmear_translate a f⟩
  intro x hx
  exact hs hx

theorem localized_translate (a : Spacetime) (O : Set Spacetime) (v : H1)
    (hv : v ∈ localized O) : U1 (fun i => a i) v ∈ localized (translateRegion a O) := by
  let T : H1 →L[ℝ] H1 :=
    (U1 (fun i => a i)).toLinearIsometry.toContinuousLinearMap.restrictScalars ℝ
  have hs : (Submodule.span ℝ (supportedGenerators O)).map T.toLinearMap ≤
      Submodule.span ℝ (supportedGenerators (translateRegion a O)) := by
    rw [Submodule.map_span]
    apply Submodule.span_le.mpr
    rintro w ⟨v,hv,rfl⟩
    exact Submodule.subset_span (translated_generator a O v hv)
  exact (Submodule.topologicalClosure_mono hs)
    ((Submodule.topologicalClosure_map T _)
      (Submodule.mem_map.mpr ⟨v,hv,rfl⟩))

theorem translateRegion_inverse (a : Spacetime) (O : Set Spacetime) :
    translateRegion (-a) (translateRegion a O)=O := by
  ext x
  simp [translateRegion]

theorem localized_translate_iff (a : Spacetime) (O : Set Spacetime) (v : H1) :
    v ∈ localized O ↔ U1 (fun i => a i) v ∈ localized (translateRegion a O) := by
  constructor
  · exact localized_translate a O v
  · intro hv
    have h:=localized_translate (-a) (translateRegion a O) (U1 (fun i => a i) v) hv
    rw [translateRegion_inverse] at h
    have hi : U1 (fun i => (-a) i) (U1 (fun i => a i) v)=v := by
      have hh:=congrArg (fun u : H1 ≃ₗᵢ[ℂ] H1 => u v)
        (U1_add (fun i => a i) (fun i => (-a) i))
      simpa using hh.symm
    rwa [hi] at h

theorem localized_univ_nonzero : ∃ v : H1,v ∈ localized Set.univ ∧ v≠0 := by
  obtain ⟨f,hf⟩:=exists_nonzero_real_circularSmear
  refine ⟨circularSmear f.val,?_,hf⟩
  exact (Submodule.le_topologicalClosure _)
    (Submodule.subset_span ⟨f.val,f.property,Set.subset_univ _,rfl⟩)

end F1Fecho.MaxwellLocalization
#print axioms F1Fecho.MaxwellLocalization.localized_mono
#print axioms F1Fecho.MaxwellLocalization.localized_translate
#print axioms F1Fecho.MaxwellLocalization.localized_translate_iff
#print axioms F1Fecho.MaxwellLocalization.localized_univ_nonzero
