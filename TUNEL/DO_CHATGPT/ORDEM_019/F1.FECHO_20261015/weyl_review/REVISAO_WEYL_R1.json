  "verdict": "PASSA_NO_ESCOPO_COM_RESSALVA_DE_INTEGRACAO_MODULAR",
  "checks": [
    {
      "id": "cocycle",
      "verdict": "PASSA",
      "statute": "REAL",
      "finding": "A convenção D(f)e(g)=exp(-<f,f>/2-<f,g>)e(g+f) preserva Gram com o produto interno antilinear à esquerda. A composição deriva D(f)D(g)=exp(-i Im<f,g>)D(f+g). Não há um fator 1/2 omitido: o parâmetro simplético desta convenção é 2 Im<f,g>."
    },
    {
      "id": "extension",
      "verdict": "PASSA",
      "statute": "REAL",
      "finding": "O módulo genérico assume apenas a família exponencial, seu kernel e totalidade. A imagem deslocada é total por translação sobrejetiva e amplitude não nula. GramTotalExtension constrói a isometria/equivalência; nenhum Weyl, CCR, inverso ou covariância é um campo assumido. A revisão independente do Gram é do root, pinada abaixo."
    },
    {
      "id": "star_locality",
      "verdict": "PASSA",
      "statute": "REAL",
      "finding": "W(-f)W(f)=1 deriva do cociclo; a equivalência unitária identifica o inverso com adjunto, produzindo W(f)*=W(-f). Localidade usa Im<f,g>=0 nas duas ordens, com conjugação explícita."
    },
    {
      "id": "covariance",
      "verdict": "PASSA",
      "statute": "REAL",
      "finding": "A covariância genérica deriva da ação V e(g)=e(ug) e da invariância da amplitude. Na instanciação concreta essa hipótese é descarregada por gamma_exponential. As hipóteses de operador Weyl/kernel/totalidade desaparecem do enunciado concreto."
    },
    {
      "id": "same_fock",
      "verdict": "PASSA",
      "statute": "REAL",
      "finding": "ConcreteWeylR1 usa F1Rede.BosonicFock.F, o vacuum e exponential já construídos. W_vacuum e a característica gaussiana são derivados. Não há novo Hilbert, vácuo substituto ou densidade postulada."
    },
    {
      "id": "net_and_cyclicity",
      "verdict": "PASSA",
      "statute": "REAL",
      "finding": "R é a álgebra bicomutante dos W(K); monotonia/localidade/covariância consomem leis agora concretas. vacuum_orbit_total e global_vacuum_cyclic usam todos f:H1 e K=top. Não estabelecem ciclicidade ou separação de uma cunha."
    },
    {
      "id": "flow_scope",
      "verdict": "PASSA_COM_HIPOTESE_EXPLICITA",
      "statute": "REAL",
      "finding": "wedgeFlow continua recebendo LightNetData como dado de localização. As leis zero/add são algébricas; não são identificação modular, KMS ou construção de um habitante físico desse registro."
    }
  ],
  "integration_finding": {
    "severity": "MATERIAL_PARA_INTEGRACAO_MODULAR_FUTURA",
    "current_theorems_invalidated": false,
    "status": "ACHADO_DERIVADO__TRATAMENTO_PLANEJADO_EM_MODULO_SEPARADO",
    "finding": "O W atual é D(f), cuja órbita do vácuo é proporcional a e(f). Para f em K, a regra de Tomita na órbita é S e(f)=e(-f). Se S_K fixa K, identificar diretamente esse S com Gamma(S_K) tem sinal incompatível para f não nulo. Não se deve promover R_D(K) e Gamma(J_K) à identificação modular sem uma ponte de fase.",
    "parent_decision_declared": "Root aceitou a ressalva e planejou FieldWeylR1 com W_field(f)=D(i*f), sem 1/sqrt(2) nesta convenção, e R_field(K)=R_D(iK). A rotação i preserva inner e o cociclo; a conjugação antilinear envia i*f a -i*f quando S_K fixa f.",
    "verification_limit": "Esta revisão só verifica as quatro fontes listadas. O módulo futuro e sua integração não são considerados compilados ou aprovados por este recibo."
