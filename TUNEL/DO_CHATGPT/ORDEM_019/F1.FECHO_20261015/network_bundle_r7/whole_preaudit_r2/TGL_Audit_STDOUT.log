  [inst_4 : DecidableEq n] (g : G), g ≠ 1 → TGLExt.Ecomp (TGLExt.lam g) = 0
@TGLExt.gibbs_Ecomp : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (ρ : Matrix n n ℂ)
  (x : Matrix (G × n) (G × n) ℂ), TGLExt.gibbs (TGLExt.piRep u ρ) (TGLExt.Ecomp x) = TGLExt.gibbs (TGLExt.piRep u ρ) x
@TGLExt.gibbs_piRep_dual : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (ρ : Matrix n n ℂ)
  (x : Matrix (G × n) (G × n) ℂ), TGLExt.gibbs (TGLExt.piRep u ρ) x = TGLExt.gibbs ρ (TGLExt.EhatDown u x)
