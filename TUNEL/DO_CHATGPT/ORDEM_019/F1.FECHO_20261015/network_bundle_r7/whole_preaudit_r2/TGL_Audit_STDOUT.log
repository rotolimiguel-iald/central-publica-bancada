  (hρ : ρ.PosDef) (a : Matrix n n ℂ),
  (TGLExt.boundaryState ρ ⋯) a = TGLExt.frob (TGLExt.Omega ρ) ((TGLExt.Lmul a) (TGLExt.Omega ρ))
