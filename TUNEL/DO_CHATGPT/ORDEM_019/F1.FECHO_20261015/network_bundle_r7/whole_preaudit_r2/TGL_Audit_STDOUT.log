  (a : Matrix n n ℂ), (TGLExt.transport ρ t s a).trace = a.trace
@TGLExt.transport_corner : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (ρ H : Matrix n n ℂ),
  Commute ρ H → ∀ (f : ℝ → ℝ) (t s : ℝ), TGLExt.transport ρ t s (cfc f H) = cfc f H
TGLExt.NamedTransportData : Type → Type
@TGLExt.canonicalNamedTransport : {n : Type} →
  [Fintype n] → [DecidableEq n] → Matrix n n ℂ → TGLExt.NamedTransportData (Matrix n n ℂ)
