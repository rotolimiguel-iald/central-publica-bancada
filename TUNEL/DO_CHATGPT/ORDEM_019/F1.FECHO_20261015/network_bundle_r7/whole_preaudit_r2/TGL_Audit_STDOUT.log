@TGLExt.pairing_bilinear_left : ∀ {n : Type} [inst : Fintype n] [DecidableEq n] (ρ₁ ρ₂ a : Matrix n n ℂ),
  TGLExt.gibbs (ρ₁ + ρ₂) a = TGLExt.gibbs ρ₁ a + TGLExt.gibbs ρ₂ a
