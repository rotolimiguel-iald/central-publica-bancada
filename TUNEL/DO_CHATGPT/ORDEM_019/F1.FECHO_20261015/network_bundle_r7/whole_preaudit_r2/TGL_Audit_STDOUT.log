  (∀ (i : n), 0 < p i) →
    ∑ i, q i = 0 → HasDerivAt (fun ε => -∑ i, (p i + ε * q i) * Real.log (p i + ε * q i)) (∑ i, q i * -Real.log (p i)) 0
