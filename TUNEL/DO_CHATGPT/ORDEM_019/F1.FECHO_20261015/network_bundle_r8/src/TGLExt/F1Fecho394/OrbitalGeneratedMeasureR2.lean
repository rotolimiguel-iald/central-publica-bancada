import TGLExt.F1Fecho394.OrbitalOrientedBoostR1
/-! The actual subgroup generated by spatial orthogonal matrices and the
longitudinal boost has a measure-preserving mass-shell action. No assertion
that this subgroup exhausts the future Lorentz group is made here. -/
set_option autoImplicit false
set_option maxHeartbeats 1600000
noncomputable section
open MeasureTheory Filter Set Matrix
namespace F1Fecho.OrbitalSpatial
open TGLExt TGLExt.ImportedSQ TGLExt.ContratoQGv31
open ChatgptAudit.WignerRapidityMeasure016

def momentumOf (a : Fin 4 → ℝ) : MomentumCoordinates := (![a 2,a 3],a 1)

theorem momentumOf_shell (p : MomentumCoordinates) : momentumOf (shellMomentum 0 p)=p := by
  apply Prod.ext
  · funext i; fin_cases i <;> rfl
  · rfl

theorem shell_injective : Function.Injective (shellMomentum 0) := by
  intro p q h
  simpa only [momentumOf_shell] using congrArg momentumOf h

def ShellLift (L : LorentzGrp) (r : MomentumCoordinates → MomentumCoordinates) : Prop :=
  MeasurePreserving r (orbitalMeasure 0) (orbitalMeasure 0) ∧
    ∀ᵐ p ∂orbitalMeasure 0, shellMomentum 0 (r p)=L.val.mulVec (shellMomentum 0 p)

def HasShellLift (L : LorentzGrp) : Prop := ∃ r, ShellLift L r

theorem shellLift_unique {L : LorentzGrp} {r s : MomentumCoordinates → MomentumCoordinates}
    (hr : ShellLift L r) (hs : ShellLift L s) : r=ᵐ[orbitalMeasure 0] s := by
  filter_upwards [hr.2,hs.2] with p hp hq
  exact shell_injective (hp.trans hq.symm)

theorem shellLift_one : ShellLift 1 id := by
  refine ⟨MeasurePreserving.id _,Filter.Eventually.of_forall ?_⟩
  intro p
  change shellMomentum 0 p=(1 : Matrix (Fin 4) (Fin 4) ℝ).mulVec _
  simp

theorem shellLift_mul {L M : LorentzGrp}
    {r s : MomentumCoordinates → MomentumCoordinates}
    (hr : ShellLift L r) (hs : ShellLift M s) : ShellLift (L*M) (r∘s) := by
  refine ⟨hr.1.comp hs.1,?_⟩
  have hp := hs.1.quasiMeasurePreserving.ae hr.2
  filter_upwards [hp,hs.2] with p h1 h2
  change shellMomentum 0 (r (s p))=(L.val*M.val).mulVec (shellMomentum 0 p)
  rw [h1,h2,Matrix.mulVec_mulVec]

theorem hasShellLift_mul {L M : LorentzGrp} (hL : HasShellLift L)
    (hM : HasShellLift M) : HasShellLift (L*M) := by
  obtain ⟨r,hr⟩ := hL
  obtain ⟨s,hs⟩ := hM
  exact ⟨r∘s,shellLift_mul hr hs⟩

def shellAdmissible : Subgroup LorentzGrp where
  carrier := {L | HasShellLift L ∧ HasShellLift L⁻¹}
  one_mem' := by
    change HasShellLift 1 ∧ HasShellLift (1 : LorentzGrp)⁻¹
    rw [inv_one]
    exact ⟨⟨id,shellLift_one⟩,⟨id,shellLift_one⟩⟩
  mul_mem' := by
    intro L M hL hM
    exact ⟨hasShellLift_mul hL.1 hM.1,by simpa only [_root_.mul_inv_rev] using hasShellLift_mul hM.2 hL.2⟩
  inv_mem' := by
    intro L hL
    exact ⟨hL.2,by simpa only [inv_inv] using hL.1⟩

theorem shell_spatial (Q : Spatial ≃ₗᵢ[ℝ] Spatial) (p : MomentumCoordinates) :
    shellMomentum 0 (spatialAction Q p)=
      (spatialMatrix Q).mulVec (shellMomentum 0 p) := by
  rw [spatialMatrix_mulVec]
  have hp := momentumOf_shell p
  change shellMomentum 0 (spatialAction Q p)=
    ![(shellMomentum 0 p) 0,(spatialAction Q (momentumOf (shellMomentum 0 p))).2,
      (spatialAction Q (momentumOf (shellMomentum 0 p))).1 0,
      (spatialAction Q (momentumOf (shellMomentum 0 p))).1 1]
  rw [hp]
  change ![energy (transverseMass 0 (spatialAction Q p).1) (spatialAction Q p).2,
    (spatialAction Q p).2,(spatialAction Q p).1 0,(spatialAction Q p).1 1]=_
  rw [spatialAction_energy]
  rfl

theorem shellLift_spatial (q : SpatialOrthogonal) :
    ShellLift (orthogonalLorentzHom q) (spatialAction (Unitary.linearIsometryEquiv q)) :=
  ⟨spatialAction_orbital _ 0,Filter.Eventually.of_forall (shell_spatial _)⟩

theorem shell_boost_ae (s : ℝ) :
    ∀ᵐ p ∂orbitalMeasure 0, shellMomentum 0 (coordinateBoost 0 s p)=
      (theBoost s).val.mulVec (shellMomentum 0 p) := by
  have hchart : ∀ᵐ p ∂momentumMeasure,
      shellMomentum 0 (coordinateBoost 0 s (rapidityChart 0 p))=
        wedgeBoostMap s (shellMomentum 0 (rapidityChart 0 p)) := by
    have hq : ∀ᵐ p ∂momentumMeasure, p.1 ≠ (0 : Transverse) := by
      rw [ae_iff]
      have hs : {p : MomentumCoordinates | ¬p.1 ≠ (0 : Transverse)} =
          ({0} : Set Transverse) ×ˢ (Set.univ : Set ℝ) := by ext p; simp
      rw [hs]
      exact exceptional_axis_null
    filter_upwards [hq] with p hp
    have hr := transverseMass_pos_of_ne_zero 0 p.1 hp
    rw [boost_chart_intertwines_of_positive 0 s p hr]
    exact shellMomentum_chart_shift 0 s p hr
  have hinv := (inverseRapidityChart_measurePreserving 0).quasiMeasurePreserving.ae hchart
  filter_upwards [hinv,chart_inverse_ae 0] with p hp hc
  simpa only [hc,id_eq,wedgeBoostMap,theBoost] using hp

theorem shellLift_boost (s : ℝ) : ShellLift (theBoost s) (coordinateBoost 0 s) :=
  ⟨coordinateBoost_measurePreserving 0 s,shell_boost_ae s⟩

theorem theBoost_zero_eq : theBoost 0=(1 : LorentzGrp) := by
  apply Subtype.ext
  change boostMat 0=(1 : Matrix (Fin 4) (Fin 4) ℝ)
  exact TGLExt.ContratoQGv31.boostMat_zero

theorem theBoost_inv_eq (s : ℝ) : (theBoost s)⁻¹=theBoost (-s) := by
  apply inv_eq_of_mul_eq_one_right
  rw [theBoost_add,add_neg_cancel,theBoost_zero_eq]

def orbitalGenerators : Set LorentzGrp :=
  Set.range orthogonalLorentzHom ∪ Set.range theBoost

def generatedLorentz : Subgroup LorentzGrp := Subgroup.closure orbitalGenerators

theorem generators_admissible : orbitalGenerators ⊆ shellAdmissible := by
  intro L hL
  rcases hL with ⟨q,rfl⟩ | ⟨s,rfl⟩
  · refine ⟨⟨_,shellLift_spatial q⟩,?_⟩
    rw [←map_inv]
    exact ⟨_,shellLift_spatial q⁻¹⟩
  · refine ⟨⟨_,shellLift_boost s⟩,?_⟩
    rw [theBoost_inv_eq]
    exact ⟨_,shellLift_boost (-s)⟩

theorem generated_admissible : generatedLorentz ≤ shellAdmissible :=
  (Subgroup.closure_le _).mpr generators_admissible

theorem spatial_mem_generated (q : SpatialOrthogonal) : orthogonalLorentzHom q ∈ generatedLorentz :=
  Subgroup.subset_closure (Or.inl ⟨q,rfl⟩)

theorem boost_mem_generated (s : ℝ) : theBoost s ∈ generatedLorentz :=
  Subgroup.subset_closure (Or.inr ⟨s,rfl⟩)

