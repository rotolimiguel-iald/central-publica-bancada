  H.IsHermitian →
    ∀ (v η : n → ℂ),
      HasDerivAt (fun ε => (star (v + ↑ε • η) ⬝ᵥ H.mulVec (v + ↑ε • η)).re) (2 * (star η ⬝ᵥ H.mulVec v).re) 0
@TGLExt.critical_pairing_iff : ∀ {n : Type} [inst : Fintype n] [DecidableEq n] (H : Matrix n n ℂ) (v : n → ℂ),
  (∀ (η : n → ℂ), star η ⬝ᵥ H.mulVec v = 0) ↔ H.mulVec v = 0
@TGLExt.transport : {n : Type} → [Fintype n] → [DecidableEq n] → Matrix n n ℂ → ℝ → ℝ → Matrix n n ℂ → Matrix n n ℂ
@TGLExt.transport_refl : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (ρ : Matrix n n ℂ) (t : ℝ)
  (a : Matrix n n ℂ), TGLExt.transport ρ t t a = a
@TGLExt.transport_comp : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (ρ : Matrix n n ℂ) (t r s : ℝ)
  (a : Matrix n n ℂ), TGLExt.transport ρ t r (TGLExt.transport ρ r s a) = TGLExt.transport ρ t s a
@TGLExt.transport_fixes_name : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (ρ : Matrix n n ℂ) (t s : ℝ)
  (a : Matrix n n ℂ), TGLExt.gibbs ρ (TGLExt.transport ρ t s a) = TGLExt.gibbs ρ a
