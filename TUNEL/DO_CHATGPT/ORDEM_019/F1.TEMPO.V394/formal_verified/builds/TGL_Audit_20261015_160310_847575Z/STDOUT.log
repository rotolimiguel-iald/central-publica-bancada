@TGLExt.ppIndexDiag_eq_card : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] [Nonempty n],
  TGLExt.ppIndexDiag n = ↑(Fintype.card n)
@TGLExt.trace_Lmul_eD : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (x : Matrix n n ℂ),
  (LinearMap.trace ℂ (Matrix n n ℂ)) (TGLExt.Lmul x * TGLExt.eD) = x.trace
@TGLExt.trace_Lmul_eTr : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (x : Matrix n n ℂ),
  (LinearMap.trace ℂ (Matrix n n ℂ)) (TGLExt.Lmul x * TGLExt.eTr) = x.trace / ↑(Fintype.card n)
@TGLExt.tau_eD : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] [Nonempty n],
  TGLExt.trOne TGLExt.eD = 1 / ↑(Fintype.card n)
@TGLExt.tau_eTr : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] [Nonempty n],
  TGLExt.trOne TGLExt.eTr = 1 / ↑(Fintype.card n) ^ 2
@TGLExt.masa_tower_weight_eq_ppBest : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] [Nonempty n],
  TGLExt.trOne TGLExt.eD = ↑(TGLExt.ppBestDiag n)
@TGLExt.pp_ne_tower_for_scalars : ∀ {n : Type} [inst : Fintype n],
  1 < Fintype.card n → 1 / ↑(Fintype.card n) ≠ 1 / ↑(Fintype.card n) ^ 2
@TGLExt.end_reconstruction : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (Φ : Module.End ℂ (Matrix n n ℂ)),
  Φ = ∑ p, TGLExt.Lmul (TGLExt.Cmat Φ p.1 p.2) * TGLExt.Rmul (Matrix.single p.1 p.2 1)
@TGLExt.Cmat_of_sum : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (D : n → n → Matrix n n ℂ) (k₀ l₀ : n),
  TGLExt.Cmat (∑ p, TGLExt.Lmul (D p.1 p.2) * TGLExt.Rmul (Matrix.single p.1 p.2 1)) k₀ l₀ = D k₀ l₀
@TGLExt.commutant_Cmat_comm : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] {A : Set (Matrix n n ℂ)}
  {Φ : Module.End ℂ (Matrix n n ℂ)},
  Φ ∈ TGLExt.commutantSet (TGLExt.Lmul '' A) →
    ∀ {a : Matrix n n ℂ}, a ∈ A → ∀ (k l : n), a * TGLExt.Cmat Φ k l = TGLExt.Cmat Φ k l * a
@TGLExt.exists_span_form : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] {A : Set (Matrix n n ℂ)}
  {Φ : Module.End ℂ (Matrix n n ℂ)},
  Φ ∈ TGLExt.commutantSet (TGLExt.Lmul '' A) →
    Φ ∈ Submodule.span ℂ {f | ∃ x y, (∀ a ∈ A, a * x = x * a) ∧ f = TGLExt.Lmul x * TGLExt.Rmul y}
@TGLExt.frob_self_eq_zero_iff : ∀ {n : Type} [inst : Fintype n] (x : Matrix n n ℂ), TGLExt.frob x x = 0 ↔ x = 0
@TGLExt.disjoint_frobOrtho : ∀ {n : Type} [inst : Fintype n] (W : Submodule ℂ (Matrix n n ℂ)),
  Disjoint W (TGLExt.frobOrtho W)
@TGLExt.isCompl_frobOrtho : ∀ {n : Type} [inst : Fintype n] (W : Submodule ℂ (Matrix n n ℂ)),
  IsCompl W (TGLExt.frobOrtho W)
@TGLExt.frobProj_comm_Lmul : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] {A : Set (Matrix n n ℂ)},
  (∀ a ∈ A, ∀ b ∈ A, a * b ∈ A) →
    (∀ a ∈ A, a.conjTranspose ∈ A) →
      ∀ {a : Matrix n n ℂ},
        a ∈ A →
          TGLExt.Lmul a * TGLExt.frobProj (Submodule.span ℂ A) = TGLExt.frobProj (Submodule.span ℂ A) * TGLExt.Lmul a
@TGLExt.finite_bicommutant : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] {A : Set (Matrix n n ℂ)},
  1 ∈ A →
    (∀ a ∈ A, ∀ b ∈ A, a * b ∈ A) →
      (∀ a ∈ A, a.conjTranspose ∈ A) →
        TGLExt.commutantSet (TGLExt.commutantSet (TGLExt.Lmul '' A)) = TGLExt.Lmul '' ↑(Submodule.span ℂ A)
TGLExt.Grot_sq : TGLExt.Grot * TGLExt.Grot = -1
TGLExt.exp_smul_Grot : ∀ (θ : ℝ), NormedSpace.exp (↑θ • TGLExt.Grot) = TGLExt.Smat θ
TGLExt.Smat_mem_unitary : ∀ (θ : ℝ), TGLExt.Smat θ ∈ unitary (Matrix (Fin 2) (Fin 2) ℂ)
TGLExt.Smat_mul : ∀ (a b : ℝ), TGLExt.Smat a * TGLExt.Smat b = TGLExt.Smat (a + b)
TGLExt.Smat_spectral : ∀ (θ : ℝ),
  TGLExt.Smat θ =
    TGLExt.Umat * Matrix.diagonal ![Complex.exp (↑θ * Complex.I), Complex.exp (-(↑θ * Complex.I))] * TGLExt.Uinv
TGLExt.normSq_reflection_add_transmission : ∀ (θ : ℝ),
  Complex.normSq ((TGLExt.Smat θ).mulVec TGLExt.e1 1) + Complex.normSq ((TGLExt.Smat θ).mulVec TGLExt.e1 0) = 1
TGLExt.rhoOut_trace : ∀ (θ : ℝ), (TGLExt.rhoOut θ).trace = 1
@TGLExt.cocycle_chain : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi chi : Matrix n n ℂ) (t : ℝ),
  TGLExt.cocycle phi psi t * TGLExt.cocycle psi chi t = TGLExt.cocycle phi chi t
@TGLExt.cocycle_triangle : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi chi : Matrix n n ℂ)
  (t : ℝ), TGLExt.cocycle phi psi t * TGLExt.cocycle psi chi t * TGLExt.cocycle chi phi t = 1
@TGLExt.cocycle_temporal : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi : Matrix n n ℂ) (s t : ℝ),
  TGLExt.cocycle phi psi (s + t) = TGLExt.cocycle phi psi s * TGLExt.sigma psi s (TGLExt.cocycle phi psi t)
@TGLExt.cocycle_conjTranspose : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi : Matrix n n ℂ)
  (t : ℝ), (TGLExt.cocycle phi psi t).conjTranspose = TGLExt.cocycle psi phi t
@TGLExt.cocycle_mem_unitary : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi : Matrix n n ℂ) (t : ℝ),
  TGLExt.cocycle phi psi t ∈ unitary (Matrix n n ℂ)
@TGLExt.cocycle_of_commute : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi : Matrix n n ℂ),
  Commute (TGLExt.logRho phi) (TGLExt.logRho psi) →
    ∀ (t : ℝ), TGLExt.cocycle phi psi t = NormedSpace.exp ((↑t * Complex.I) • (TGLExt.logRho phi - TGLExt.logRho psi))
@TGLExt.logRho_conj : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi V : Matrix n n ℂ),
  V ∈ unitary (Matrix n n ℂ) →
    phi.PosDef → TGLExt.logRho (V * phi * V.conjTranspose) = V * TGLExt.logRho phi * V.conjTranspose
@TGLExt.modPow_conj : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi V : Matrix n n ℂ),
  V ∈ unitary (Matrix n n ℂ) →
    phi.PosDef → ∀ (t : ℝ), TGLExt.modPow (V * phi * V.conjTranspose) t = V * TGLExt.modPow phi t * V.conjTranspose
@TGLExt.cocycle_covariance : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (phi psi V : Matrix n n ℂ),
  V ∈ unitary (Matrix n n ℂ) →
    phi.PosDef →
      psi.PosDef →
        ∀ (t : ℝ),
          TGLExt.cocycle (V * phi * V.conjTranspose) (V * psi * V.conjTranspose) t =
            V * TGLExt.cocycle phi psi t * V.conjTranspose
@TGLExt.sigma_fixed_of_commute : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (rho x : Matrix n n ℂ),
  Commute rho x → ∀ (t : ℝ), TGLExt.sigma rho t x = x
@TGLExt.logRho_diagonal : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (d : n → ℝ),
  (∀ (i : n), 0 < d i) → TGLExt.logRho (TGLExt.rhoD d) = Matrix.diagonal fun i => ↑(Real.log (d i))
@TGLExt.sigma_fixed_iff_diag : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (d : n → ℝ),
  (∀ (i : n), 0 < d i) →
    Function.Injective d →
      ∀ (x : Matrix n n ℂ), (∀ (t : ℝ), TGLExt.sigma (TGLExt.rhoD d) t x = x) ↔ x = TGLExt.diagExpect x
@TGLExt.gibbs_tracial_on_centralizer : ∀ {n : Type} [inst : Fintype n] (rho x y : Matrix n n ℂ),
  Commute rho x → TGLExt.gibbs rho (x * y) = TGLExt.gibbs rho (y * x)
@TGLExt.dephase_add : ∀ {n : Type} (g : n → n → ℝ) (s t : ℝ) (x : Matrix n n ℂ),
  TGLExt.dephase g (s + t) x = TGLExt.dephase g s (TGLExt.dephase g t x)
@TGLExt.dephase_tendsto_expectation : ∀ {n : Type} [inst : DecidableEq n] (g : n → n → ℝ),
  (∀ (i : n), g i i = 0) →
    (∀ (i j : n), i ≠ j → 0 < g i j) →
      ∀ (x : Matrix n n ℂ), Filter.Tendsto (fun t => TGLExt.dephase g t x) Filter.atTop (nhds (TGLExt.diagExpect x))
@TGLExt.ergodic_convergence_modular : ∀ {n : Type} [inst : DecidableEq n] (d : n → ℝ),
  (∀ (i : n), 0 < d i) →
    Function.Injective d →
      ∀ (x : Matrix n n ℂ),
        Filter.Tendsto (fun t => TGLExt.dephase (TGLExt.modularGap d) t x) Filter.atTop (nhds (TGLExt.diagExpect x))
@TGLExt.lam_one : ∀ {G : Type} [inst : Group G] [Fintype G] [inst_2 : DecidableEq G] {n : Type} [Fintype n]
  [inst_4 : DecidableEq n], TGLExt.lam 1 = 1
@TGLExt.lam_mul : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (g h : G), TGLExt.lam g * TGLExt.lam h = TGLExt.lam (g * h)
@TGLExt.lam_conjTranspose : ∀ {G : Type} [inst : Group G] [Fintype G] [inst_2 : DecidableEq G] {n : Type} [Fintype n]
  [inst_4 : DecidableEq n] (g : G), (TGLExt.lam g).conjTranspose = TGLExt.lam g⁻¹
@TGLExt.lam_mem_unitary : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (g : G), TGLExt.lam g ∈ unitary (Matrix (G × n) (G × n) ℂ)
@TGLExt.piRep_mul : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (a b : Matrix n n ℂ),
  TGLExt.piRep u (a * b) = TGLExt.piRep u a * TGLExt.piRep u b
@TGLExt.piRep_star : ∀ {G : Type} [inst : Group G] [Fintype G] [inst_2 : DecidableEq G] {n : Type} [inst_3 : Fintype n]
  [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (a : Matrix n n ℂ),
  TGLExt.piRep u a.conjTranspose = (TGLExt.piRep u a).conjTranspose
@TGLExt.piRep_injective : ∀ {G : Type} [inst : Group G] [Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)),
  Function.Injective (TGLExt.piRep u)
@TGLExt.lam_conj_piRep : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (g : G) (a : Matrix n n ℂ),
  TGLExt.lam g * TGLExt.piRep u a * (TGLExt.lam g).conjTranspose = TGLExt.piRep u (TGLExt.alphaAct u g a)
@TGLExt.lam_mul_piRep : ∀ {G : Type} [inst : Group G] [inst_1 : Fintype G] [inst_2 : DecidableEq G] {n : Type}
  [inst_3 : Fintype n] [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (g : G) (a : Matrix n n ℂ),
  TGLExt.lam g * TGLExt.piRep u a = TGLExt.piRep u (TGLExt.alphaAct u g a) * TGLExt.lam g
@TGLExt.Ecomp_idem : ∀ {G : Type} [Group G] [Fintype G] [inst : DecidableEq G] {n : Type} [Fintype n] [DecidableEq n]
  (x : Matrix (G × n) (G × n) ℂ), TGLExt.Ecomp (TGLExt.Ecomp x) = TGLExt.Ecomp x
@TGLExt.Ecomp_piRep : ∀ {G : Type} [inst : Group G] [Fintype G] [inst_2 : DecidableEq G] {n : Type} [inst_3 : Fintype n]
  [inst_4 : DecidableEq n] (u : G →* ↥(Matrix.unitaryGroup n ℂ)) (a : Matrix n n ℂ),
  TGLExt.Ecomp (TGLExt.piRep u a) = TGLExt.piRep u a
