    ∑ i, q i = 0 →
      ∀ (c : ℝ),
        (∀ (i : n), Real.log (p i) + h i = c) →
          HasDerivAt (fun ε => -∑ i, (p i + ε * q i) * Real.log (p i + ε * q i) - ∑ i, (p i + ε * q i) * h i) 0 0
@TGLExt.elementary_critical_implies_gibbs : ∀ {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] (p h : n → ℝ),
  (∀ (i j : n), -Real.log (p i) - h i - (-Real.log (p j) - h j) = 0) → ∃ c, ∀ (i : n), Real.log (p i) + h i = c
@TGLExt.gibbs_nonneg : ∀ {n : Type} [inst : Fintype n] [DecidableEq n] {ρ x : Matrix n n ℂ},
  ρ.PosSemidef → x.PosSemidef → 0 ≤ TGLExt.gibbs ρ x
