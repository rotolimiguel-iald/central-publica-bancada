  TGLExt.purity x = ↑(TGLExt.purityR x)
@TGLExt.dephase_purityR_le : ∀ {n : Type} [inst : Fintype n] [DecidableEq n] (g : n → n → ℝ) (t : ℝ),
  0 ≤ t → (∀ (i j : n), 0 ≤ g i j) → ∀ (x : Matrix n n ℂ), TGLExt.purityR (TGLExt.dephase g t x) ≤ TGLExt.purityR x
