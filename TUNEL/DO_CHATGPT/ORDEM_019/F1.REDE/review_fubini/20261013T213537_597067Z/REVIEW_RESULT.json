  "semantic_checks": [
    {
      "check": "strong_measurability",
      "result": "PASSA",
      "anchor": "FubiniL2.lean:85",
      "reason": "Good sections form a measurable set. Distances to every L2 vector are measurable; separability gives second countability and strong measurability. Bad sections are zero on a null set."
    },
    {
      "check": "integral_and_norm",
      "result": "PASSA",
      "anchor": "FubiniL2.lean:122",
      "reason": "Square norm is integrable from MemLp 2, then integral_prod_symm and a.e. section equality establish squared-norm disintegration. This proves norm preservation."
    },
    {
      "check": "surjectivity",
      "result": "PASSA",
      "anchor": "FubiniL2.lean:220",
      "reason": "Finite-measure indicator functions have explicit rectangular preimages. Lp induction uses addition and closed range of an isometry from the complete product L2. Surjectivity is proved, not assumed."
    },
    {
      "check": "unchanged_canonical_H1_measure_Fib",
      "result": "PASSA",
      "anchor": "FubiniL2.lean:246",
      "reason": "Fib is EuclideanSpace complex (Fin 2). momentumMeasure is Lebesgue on Transverse times real rapidity. H1 remains Lp Fib 2 orbitalMeasure(0); existing toRapidity supplies the equivalence before currification."
    },
    {
      "check": "boost_intertwining",
      "result": "PASSA",
      "anchor": "FubiniL2.lean:265",
      "reason": "A.e. sections intertwine productRapidityShift with actual real shift. Existing orbitalScalarBoost_intertwines and fourier_shift yield negative-sign Fourier character with 2*pi*s, hence sigma=4*pi^2*xi for B0(-2*pi*t)."
    },
    {
      "check": "actual_surjective_canonical_objects",
      "result": "PASSA",
      "anchor": "ReviewProbe.lean:3",
      "reason": "Independent examples type surjectivity of both canonical equivalences and inverse cancellation with no proof parameters."
    }
  ],
